# Security headers for every response of the console, applied by Cloudflare
# Pages from the build output. The API sends the same set on its own responses.
# What each line allows, and why: docs/adr/0015-the-console-sends-its-own-security-headers.md.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self' data:; img-src 'self'; connect-src https://api.aleksadragnic.com; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Vite names every file under /assets/ by a hash of its content, so a changed
# file is a new URL and the old one may be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The link preview image is fetched by other sites' previewers; it is the one
# file the console lets another origin load.
/og.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
