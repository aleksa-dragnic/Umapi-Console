# Copy to .env.local for a local run; neither file is committed except this one.
# Nothing here is secret: every VITE_ variable ends up in the bundle.

# The API's origin, with no path (the generated paths begin with /api/v1).
# Unset, the console talks to the deployed instance.
# For a local API use localhost, not 127.0.0.1: the refresh cookie belongs to the site.
VITE_API_BASE_URL=http://localhost:5085

# `live` sends the dev server's requests to that API. Anything else, or unset,
# answers them from the mock in the browser. Production builds never load the mock.
VITE_API_MODE=live
